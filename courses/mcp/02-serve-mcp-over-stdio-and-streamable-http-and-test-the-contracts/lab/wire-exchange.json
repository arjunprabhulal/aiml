                "type": "object",
                "properties": {
                  "title": {
                    "maxLength": 80,
                    "minLength": 3,
                    "title": "Title",
                    "type": "string"
                  },
                  "priority": {
                    "default": "normal",
                    "enum": [
                      "low",
                      "normal",
                      "high"
                    ],
                    "title": "Priority",
                    "type": "string"
                  }
                },
