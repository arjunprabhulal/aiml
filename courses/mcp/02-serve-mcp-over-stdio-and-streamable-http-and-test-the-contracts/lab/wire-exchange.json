                  "id": {
                    "description": "Task ID such as T-1.",
                    "title": "Id",
                    "type": "string"
                  },
                  "title": {
                    "title": "Title",
                    "type": "string"
                  },
                  "priority": {
                    "enum": [
                      "low",
                      "normal",
                      "high"
                    ],
                    "title": "Priority",
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "open",
                      "done"
                    ],
                    "title": "Status",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "priority",
                  "status"
                ],
                "title": "Task",
                "type": "object"
              }
            },
            {
