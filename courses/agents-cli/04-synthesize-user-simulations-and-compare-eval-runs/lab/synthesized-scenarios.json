              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Docuctl auth tokens stay valid for **90 days**. \n\nTokens cannot be renewed directly; you must generate a new token to replace the expired one using:\n\n```bash\ndocuctl tokens create --name ci-docs-api --scope deploy:staging\n```\n\nUpdate the new value in your CI secret store as `DOCUCTL_TOKEN`. You can check token expiration dates at any time with `docuctl tokens list`."
              }
            ],
            "role": "model"
          },
