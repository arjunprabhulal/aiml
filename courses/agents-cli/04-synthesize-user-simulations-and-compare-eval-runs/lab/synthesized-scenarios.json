          "invocation_id": "e-af9ad425-a0d1-4e03-aebb-d26a17375c48",
          "user_content": {
            "parts": [
              {
                "text": "I need to urgently roll back our last deploy using docuctl. How do I do that? We are currently running docuctl 2.1."
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "For docuctl 2.1, run the following command to roll back to the previous release:\n\n```bash\ndocuctl rollback --env <environment>\n```\n\n(Replace `<environment>` with your target environment, e.g., `production`.) \n\nOmitting `--to` automatically rolls back to the immediately preceding release. Note that database migrations are not rolled back automatically."
              }
            ],
            "role": "model"
          },
