      "url": "https://docs.python.org/3.12/library/json.html#json.dumps",
      "fact_status": "original summary; primary docs checked",
      "text": "json.dumps(obj, ensure_ascii=True) returns a JSON string. Setting ensure_ascii=False leaves non-ASCII characters in that string. It does not write a file or select the encoding used by a file writer.",
