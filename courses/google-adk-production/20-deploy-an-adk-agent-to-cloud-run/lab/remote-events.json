      {
        "modelVersion": "gemini-3.8-flash",
        "content": {
          "parts": [
            {
              "text": "In docuctl 1.x, use `docuctl release revert`:\n\n```bash\ndocuctl release revert r42 --env production\n```\n\nThis reverts release `r42` in production. Note that database migrations are not automatically rolled back, so any migrations introduced by `r42` must be reversed manually with a new migration."
            }
          ],
          "role": "model"
        },
